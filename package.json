{
  "name": "@flanj/sdk",
  "version": "0.1.0",
  "description": "Thin OpenTelemetry-JS distribution: HTTP request/response body capture with redaction-at-source, exporting the flanj.* OTLP convention to a Flanj collector.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flanj-io/sdk.git"
  },
  "homepage": "https://github.com/flanj-io/sdk#readme",
  "bugs": "https://github.com/flanj-io/sdk/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist",
    "!./dist/**/*.spec.*",
    "./README.md",
    "./REDACTION.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rm -rf dist packages/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@flanj/redaction-patterns": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
